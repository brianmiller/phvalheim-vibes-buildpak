<?xml version="1.0" encoding="utf-8"?>
<!-- Builder-only: the warm-up restore pulls from nuget.org into /pak/nuget. Never shipped. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
