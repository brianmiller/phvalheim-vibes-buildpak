<?xml version="1.0" encoding="utf-8"?>
<!--
  Build Pak NuGet sources (design section 8): the pak's own warmed cache first,
  nuget.org second. The "pak" path is RELATIVE to this file, which is how NuGet
  resolves local sources, so it works wherever the pak is extracted. The server
  disables nuget.org for offline operators by passing a config of its own or by
  `dotnet nuget disable source nuget.org` (advanced.nuget_online=false).

  The global-packages layout under nuget/ (id/version/id.version.nupkg) doubles as
  a NuGet v3 folder feed; build.sh proves a restore from it alone succeeds.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="pak" value="nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
