# Every version pin in the Build Pak lives here and nowhere else.
#
# Read by build.sh (turned into --build-arg for the Dockerfile) and by
# check-upstreams.sh (which rewrites this file and opens a PR when an upstream
# moved). Nothing in the build resolves "latest" at build time: a pak built from
# a given commit is the same pak tomorrow, and a change here is a reviewable diff.
#
# Format: KEY=VALUE, one per line, no quotes, no spaces around '='.

# --- base ---------------------------------------------------------------
# Must match the server image's distro codename (design section 8): dpkg-extracted
# binaries link against the base's libc/gnutls. A `noble` pak is this file with
# BASE=noble and the apt pins below re-resolved. Human decision; check-upstreams
# never changes it.
BASE=jammy

# --- .NET SDK -----------------------------------------------------------
# Channel is a human decision (8.0 is LTS until Nov 2026). The exact SDK build and
# its sha512 come from Microsoft's release index
# https://builds.dotnet.microsoft.com/dotnet/release-metadata/<channel>/releases.json
# ("latest-sdk" + the linux-x64 tar.gz "hash").
DOTNET_CHANNEL=8.0
DOTNET_SDK_VERSION=8.0.426
DOTNET_SDK_SHA512=8141d01bdc53f604aed3bb661b604707a64209f8a947cd81bf95b4f518951593d77864069191f54ea5e84362a409da6b0f69074bf893b283d7e0cf93e2bf20a8

# --- BepInEx 5 (core DLLs for referencing, LGPL-2.1) --------------------
# Newest non-prerelease v5.x from https://api.github.com/repos/BepInEx/BepInEx/releases.
# The sha256 is of BepInEx_linux_x64_<version>.zip.
BEPINEX_VERSION=5.4.23.6
BEPINEX_SHA256=f8ac87a97fb1ef85451c04ace1fddb7dd7eb0b079c179b989d6bc462c98bd365

# --- dotnet tools (installed with --tool-path into tools/) --------------
# A tool's target framework must run on the SDK channel's runtime: ilspycmd 9.x is
# net8.0 (10.x and 11.x are net10.0 and will NOT start on an 8.0 runtime);
# the publicizer 0.4.x is net6.0 and rolls forward to 8.0. check-upstreams.sh
# enforces "tfm major <= channel major" by inspecting each candidate nupkg.
ILSPY_VERSION=9.1.0.7988
PUBLICIZER_VERSION=0.4.3

# --- NuGet cache warm-up -------------------------------------------------
# The one package the server's basic-plugin template needs to compile a net472
# class library on Linux (the .NET Framework reference assemblies).
REFASM_VERSION=1.0.3

# --- git (jammy's own packages, dpkg -x'ed) ------------------------------
# apt pins vanish from the archive when a newer security build lands, so a stale
# pin breaks the build loudly instead of silently shipping a different binary;
# check-upstreams.sh re-resolves them against ubuntu:$BASE.
GIT_PKG_VERSION=1:2.34.1-1ubuntu1.18
LIBCURL3_GNUTLS_PKG_VERSION=7.81.0-1ubuntu1.30
LIBERROR_PERL_PKG_VERSION=0.17029-1

# --- the runtime image the oracles run in --------------------------------
RUNTIME_IMAGE=theoriginalbrian/phvalheim-server:rc
